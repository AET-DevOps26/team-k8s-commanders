# Copy to .env.k8s (same directory), fill in real values, then `make deploy`.
# .env.k8s is gitignored; this .example file is committed.

# Where `make deploy` sends the app:
#   local -> kind cluster on your machine (scripts/deploy-local.sh)
#   aet   -> AET TUM Rancher cluster      (scripts/deploy-k8s.sh)
# Inline/make overrides win over this value: `make deploy DEPLOY_TARGET=local`.
DEPLOY_TARGET=aet

# Your TUM ID — determines namespace (<TUM_ID>-devops26) and default ingress host.
# Must be a namespace your Rancher account owns (check `kubectl auth can-i --list`;
# any namespace listed with verb `*` is yours).
TUM_ID=ge38yuc

# GHCR pull credentials (needed if the org's container packages are private).
# Generate a Personal Access Token (classic) with scope: read:packages.
# Leave empty if the images are public.
GHCR_USER=your-github-username
GHCR_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI assistant LLM key (OpenAI or OpenWebUI).
# A real key is required for /ai/query; any non-empty value passes health checks.
LLM_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Optional: only needed if you flip auth.enabled to true
AUTH_ENABLED=false
JWT_SECRET=
POSTGRES_PASSWORD=

# Optional ingress overrides
INGRESS_HOST=
INGRESS_TLS_ENABLED=true

# Image tag to deploy (defaults to "latest"); CI sets to commit SHA
IMAGE_TAG=latest
