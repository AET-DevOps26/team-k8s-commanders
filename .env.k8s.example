# OPTIONAL. The chart deploys the full stack with working dev defaults and public
# images, so `make deploy` works with NO .env.k8s at all. Copy to .env.k8s (same
# directory) only to override defaults. .env.k8s is gitignored; this file is committed.

# Where `make deploy` sends the app:
#   local -> kind cluster on your machine (scripts/deploy-local.sh)
#   aet   -> AET TUM Rancher cluster      (scripts/deploy-k8s.sh)
# Inline/make overrides win over this value: `make deploy DEPLOY_TARGET=local`.
DEPLOY_TARGET=aet

# Your TUM ID — determines namespace (<TUM_ID>-devops26-team-k8s-commanders)
# and default ingress host.
# Must be a namespace your Rancher account owns (check `kubectl auth can-i --list`;
# any namespace listed with verb `*` is yours).
TUM_ID=ge38yuc

# GHCR pull credentials — NOT needed, the packages are public. Set only if you
# fork to a private registry (PAT classic, scope read:packages).
GHCR_USER=
GHCR_PAT=

# AI assistant LLM key (OpenAI or OpenWebUI). Optional: the ai pod deploys healthy
# without it and only needs a real key to answer /ai/query.
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Optional secret overrides (otherwise the chart's dev defaults are used).
JWT_SECRET=
POSTGRES_PASSWORD=

# Optional ingress overrides
INGRESS_HOST=
INGRESS_TLS_ENABLED=true

# Image tag to deploy (defaults to "latest"); CI sets to commit SHA
IMAGE_TAG=latest
