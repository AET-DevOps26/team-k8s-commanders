# Ensure shell scripts use LF endings
*.sh text eol=lf
scripts/* text eol=lf
api/scripts/* text eol=lf
git/hooks/* text eol=lf

# Default handling for common text files
*.py text=auto
*.md text=auto
*.yaml text=auto
*.yml text=auto

# Generated Spring stubs — always store and check out as LF so the generator
# (which always writes LF) doesn't produce a spurious diff on Windows/WSL.
services/springboot/generated/src/**/*.java text eol=lf
