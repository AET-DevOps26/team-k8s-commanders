# Copy to .env.k8s at repo root and fill in real values, then `make deploy`.
# .env.k8s is gitignored.

# Your TUM ID — determines namespace (<TUM_ID>-devops26) and default ingress host.
TUM_ID=ge38yuc

# GHCR pull credentials (needed if the org's container packages are private).
# Generate a Personal Access Token (classic) with scope: read:packages
GHCR_USER=your-github-username
GHCR_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AI assistant LLM key (OpenAI or OpenWebUI)
LLM_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Optional: only needed if you flip auth.enabled to true
AUTH_ENABLED=false
JWT_SECRET=
POSTGRES_PASSWORD=

# Optional ingress overrides
INGRESS_HOST=
INGRESS_TLS_ENABLED=true

# Image tag to deploy (defaults to "latest"); CI sets to commit SHA
IMAGE_TAG=latest
