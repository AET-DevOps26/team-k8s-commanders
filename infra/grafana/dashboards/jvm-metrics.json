      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "jvm_threads_live_threads{job=~\"api-gateway|auth-service|patient-service|notes-service\"}",
          "legendFormat": "{{job}} live",
          "refId": "A"
