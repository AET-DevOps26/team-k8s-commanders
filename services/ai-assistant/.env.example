# == LLM Provider Configuration ==
# Options: "openai" or "openwebui"
LLM_PROVIDER=openwebui

# == OpenAI Configuration ==
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# == OpenWebUI Configuration ==
# Only needed if LLM_PROVIDER=openwebui
# Put the exact OpenWebUI chat completions endpoint here.
OPENWEBUI_CHAT_COMPLETIONS_URL=https://gpu.aet.cit.tum.de/api/chat/completions
OPENWEBUI_API_KEY=your-openwebui-api-key
OPENWEBUI_MODEL=openai/gpt-oss-120b
