# Dev: set all vars here.
# Prod (docker-compose.prod.yml): only LLM_API_KEY is read from this file;
# the rest are declared inline in the compose environment block.

# Options: "openai" or "openwebui"
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4

# Required when LLM_PROVIDER=openwebui
OPENWEBUI_BASE_URL=https://your-openwebui-host/api

# Embeddings for the clinical-guidelines RAG path (utils/guidelines.py). Uses the
# same provider/credentials as the chat model. Defaults: text-embedding-3-small
# (1536-dim) for openai, nomic-embed-text (768-dim) for openwebui/Ollama.
# EMBEDDING_DIM must match the chosen model and the ingested collection.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Optional retrieval tuning:
# GUIDELINES_TOP_K=4
# GUIDELINES_MAX_DISTANCE=0.55

# Source-of-truth backend services the assistant pulls live context from.
# Defaults target local dev; in compose these point at the service names.
PATIENT_SERVICE_URL=http://localhost:8082
NOTES_SERVICE_URL=http://localhost:8083

# Persistent conversation sessions (Postgres). Defaults target the ai-db
# published by docker-compose on localhost:5435. Alternatively set DATABASE_URL
# to a full SQLAlchemy async DSN to override these.
DB_HOST=localhost
DB_PORT=5435
DB_NAME=ai_db
DB_USER=caredesk
DB_PASSWORD=caredesk
