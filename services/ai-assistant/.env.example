# Dev: set all vars here.
# Prod (docker-compose.prod.yml): only LLM_API_KEY is read from this file;
# the rest are declared inline in the compose environment block.

# Options: "openai" or "openwebui"
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4

# Required when LLM_PROVIDER=openwebui
OPENWEBUI_BASE_URL=https://your-openwebui-host/api
