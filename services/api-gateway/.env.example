# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit real secrets.

# Must match auth-service's JWT_SECRET so the gateway can verify tokens it issues.
JWT_SECRET=change-me-must-be-at-least-32-characters-long

# Downstream service URLs (defaults are fine when running outside docker compose).
AUTH_SERVICE_URL=http://localhost:8081
AI_ASSISTANT_URL=http://localhost:8000
