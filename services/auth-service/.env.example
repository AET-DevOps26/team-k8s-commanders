# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit real secrets.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=caredesk
DB_PASSWORD=caredesk

# JWT — must be at least 32 characters in production
JWT_SECRET=change-me-must-be-at-least-32-characters-long

# Spring (optional — defaults match application.yml)
SERVER_PORT=8081
