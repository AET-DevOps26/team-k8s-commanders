# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit real secrets.

# Database
DB_HOST=localhost
DB_PORT=5435
DB_NAME=notification_db
DB_USER=caredesk
DB_PASSWORD=caredesk

# Spring (optional — defaults match application.yml)
SERVER_PORT=8084

# Internal patient-service URL (reminder scheduler reads its upcoming feed)
PATIENT_SERVICE_URL=http://localhost:8082

# SMTP delivery — defaults target a local Mailpit (no auth, no TLS)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=CareDesk <no-reply@caredesk.local>

# Reminder scheduler (set REMINDER_ENABLED=false to turn the job off)
REMINDER_ENABLED=true
REMINDER_WINDOW_HOURS=24
REMINDER_SCAN_INTERVAL_MS=900000
